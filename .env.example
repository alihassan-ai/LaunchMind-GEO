# ── LLM ──────────────────────────────────────────────────────────────
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── GitHub ────────────────────────────────────────────────────────────
# Personal Access Token (classic) — needs: repo, workflow
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_...
# Your public repo in the format: username/launchmind-geo
GITHUB_REPO=your-username/launchmind-geo

# ── Slack ─────────────────────────────────────────────────────────────
# Bot User OAuth Token (starts with xoxb-)
# Get from: https://api.slack.com/apps -> your app -> OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-...
# Channel name including the #, e.g. #launches
SLACK_CHANNEL=#launches

# ── SendGrid (Email) ──────────────────────────────────────────────────
# Free tier: 100 emails/day — https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxx...
# A verified sender address in your SendGrid account
FROM_EMAIL=you@yourdomain.com
# Test inbox to receive the cold outreach email
TO_EMAIL=test@yourdomain.com
